<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dlg_direct_section"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_dlg_direct_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dlg_enable_direct" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_dlg_direct_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dlg_repeat_persistent" />

        <EditText
            android:id="@+id/et_dlg_direct_repeat_sec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_repeat_sec"
            android:inputType="number" />

        <EditText
            android:id="@+id/et_dlg_direct_cooldown_sec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_cooldown_sec"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/dlg_group_section"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_dlg_group_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dlg_enable_group" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_dlg_group_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dlg_repeat_persistent" />

        <EditText
            android:id="@+id/et_dlg_group_repeat_sec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_repeat_sec"
            android:inputType="number" />

        <EditText
            android:id="@+id/et_dlg_group_cooldown_sec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_cooldown_sec"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/dlg_sound_mode" />

        <Spinner
            android:id="@+id/sp_dlg_phone_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dlg_haptic_pattern" />

        <Spinner
            android:id="@+id/sp_dlg_haptic_pattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include layout="@layout/include_silent_watch_schedule" />
    </LinearLayout>
</ScrollView>
