<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_silent_section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dlg_silent_watch_section"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/sp_dlg_silent_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:id="@+id/ll_dlg_silent_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_dlg_silent_start"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/dlg_ah_start_default"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dlg_silent_end"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/dlg_ah_end_default"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_silent_days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dlg_silent_days_label"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_day_mon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_mon"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/cb_day_tue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_tue"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/cb_day_wed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_wed"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/cb_day_thu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_thu"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/cb_day_fri"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_fri"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/cb_day_sat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_sat"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/cb_day_sun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_sun"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
