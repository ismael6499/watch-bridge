<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_dialog_section"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_silent_section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.02"
        android:text="@string/dlg_silent_watch_section"
        android:textColor="@color/dialog_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:text="@string/label_silent_mode"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_input">

        <Spinner
            android:id="@+id/sp_dlg_silent_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/ll_dlg_silent_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_silent_window"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dlg_silent_start"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/dlg_ah_start_default"
                android:textAllCaps="false"
                android:textColor="@color/dialog_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/dialog_accent"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dlg_silent_end"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/dlg_ah_end_default"
                android:textAllCaps="false"
                android:textColor="@color/dialog_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/dialog_accent"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_silent_days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:text="@string/dlg_silent_days_label"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_day_mon"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_chip"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/day_mon"
                android:textColor="@color/day_chip_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_day_tue"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_chip"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/day_tue"
                android:textColor="@color/day_chip_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_day_wed"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_chip"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/day_wed"
                android:textColor="@color/day_chip_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_day_thu"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_chip"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/day_thu"
                android:textColor="@color/day_chip_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_day_fri"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_chip"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/day_fri"
                android:textColor="@color/day_chip_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_day_sat"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_chip"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/day_sat"
                android:textColor="@color/day_chip_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_day_sun"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_chip"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/day_sun"
                android:textColor="@color/day_chip_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
